# Copie para .env somente como referência. O Stanza não lê .env automaticamente.
# Exporte no terminal ou use um gerenciador de segredos.
STANZA_DB_PATH=/home/usuario/.stanza/documents.sqlite3
STANZA_OCR_LANG=por+eng

# Opcional: IA por API compatível com /chat/completions.
STANZA_LLM_API_KEY=
STANZA_LLM_MODEL=
STANZA_LLM_BASE_URL=https://api.openai.com/v1

# Opcional: exige pip install -r requirements-semantic.txt
# Modelo será baixado no primeiro uso, se não estiver no cache local.
STANZA_EMBED_MODEL=

# Opcional: autoriza o organizador a operar somente sob essa raiz local.
# Crie as pastas entrada/ e organizados/ sob ela; somente entrada/ é necessária inicialmente.
STANZA_ORGANIZE_ROOT=/home/usuario/Documentos/Stanza
